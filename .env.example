
# --- Security (required) ---
# Shared secret. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be identical in the Django backend's .env. The service refuses to start without it.
INTERNAL_API_KEY=change-me-to-a-long-random-value-min-32-chars

# --- Optional hardening knobs (defaults shown) ---
# ENABLE_DOCS=false                 # true only on a developer machine (Swagger UI + landing page)
# LOG_LEVEL=INFO
# CORS_ALLOWED_ORIGINS=             # leave empty: this is a server-to-server service
